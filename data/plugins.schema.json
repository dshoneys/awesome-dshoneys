{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshoneys.github.io/awesome-dshoneys/data/plugins.schema.json",
  "title": "DeepSeek Honeys 认证插件目录",
  "type": "object",
  "required": ["plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "demandTitle",
        "version",
        "author",
        "url",
        "description",
        "category",
        "platforms",
        "security",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "demandTitle": {
          "type": "string",
          "minLength": 1,
          "description": "首页卡片主标题：用户需求描述"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "type": "object",
          "required": ["summary"],
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "category": {
          "enum": ["productivity", "development", "data", "local", "other"]
        },
        "platforms": {
          "type": "array",
          "description": "适用平台；跨平台插件列出全部目标平台",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["windows", "linux", "macos"]
          }
        },
        "security": {
          "type": "object",
          "required": ["provider", "status", "reportUrl", "scannedAt"],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": ["community", "dsh.so"]
            },
            "status": {
              "enum": ["passed", "warning"]
            },
            "reportUrl": {
              "type": "string",
              "format": "uri"
            },
            "scannedAt": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "searchTerms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "feedback": {
          "type": "object",
          "required": ["content"],
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string"
            }
          }
        },
        "dshUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?dsh\\.so/"
        }
      }
    }
  }
}
